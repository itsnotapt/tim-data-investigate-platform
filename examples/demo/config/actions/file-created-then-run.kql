declare query_parameters(host: string, file: string, created: datetime, window: timespan);
ProcessCreations()
| where Host == host and Timestamp between (created .. (created + window))
| where Image =~ file
| project Timestamp, Host, User, Image, CommandLine, ParentImage, ParentCommandLine, ProcessId, ParentProcessId,
    ProcessGuid, ParentProcessGuid, SHA256, MD5, Computer, UtcTime, EventId
| order by Timestamp asc
| take 10000
