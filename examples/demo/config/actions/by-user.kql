declare query_parameters(user: string, around: datetime, window: timespan);
let byUserInWindow = (T: (Timestamp: datetime, User: string)) {
    T | where User == user and Timestamp between ((around - window) .. (around + window))
};
union
    (byUserInWindow(ProcessCreations())
        | extend Activity = "Process started", Detail = CommandLine),
    (byUserInWindow(NetworkConnections())
        | extend Activity = "Network connection",
            Detail = trim(@"\s+", strcat(Protocol, " ", DestinationIp, ":", DestinationPort, " ", DestinationHostname)))
| project Timestamp, Host, Activity, Image, Detail, User, ProcessGuid, ParentProcessGuid, DestinationIp,
    DestinationPort, SHA256, MD5, EventId
| order by Timestamp asc
| take 10000
