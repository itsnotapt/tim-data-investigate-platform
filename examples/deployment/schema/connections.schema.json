{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TIM connections file",
  "$defs": {
    "kusto": {
      "additionalProperties": false,
      "description": "A Kusto cluster. ``databases`` are suggestions for the analyst, not a restriction.\n\nWith ``auth: obo``, ``cluster`` is normalised to ``https://<host>`` and the scope defaults\nto ``{cluster}/.default``. ``auth: none`` is for a local Kusto emulator in development\n(ADR-0026): ``cluster`` may be ``http`` too, and keeps its scheme and port.",
      "properties": {
        "name": {
          "pattern": "^[a-z0-9-]+$",
          "title": "Name",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "type": {
          "const": "kusto",
          "title": "Type",
          "type": "string"
        },
        "auth": {
          "enum": [
            "obo",
            "none"
          ],
          "title": "Auth",
          "type": "string"
        },
        "scope": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Scope"
        },
        "cluster": {
          "title": "Cluster",
          "type": "string"
        },
        "databases": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Databases"
        }
      },
      "required": [
        "name",
        "title",
        "type",
        "auth",
        "cluster"
      ],
      "title": "kusto",
      "type": "object"
    },
    "lookup": {
      "additionalProperties": false,
      "description": "A lookup table: each key's fields. Nothing is behind it, so it runs as TIM.",
      "properties": {
        "name": {
          "pattern": "^[a-z0-9-]+$",
          "title": "Name",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "type": {
          "const": "lookup",
          "title": "Type",
          "type": "string"
        },
        "auth": {
          "const": "workload_identity",
          "title": "Auth",
          "type": "string"
        },
        "scope": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Scope"
        },
        "entries": {
          "additionalProperties": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object"
          },
          "title": "Entries",
          "type": "object"
        }
      },
      "required": [
        "name",
        "title",
        "type",
        "auth",
        "entries"
      ],
      "title": "lookup",
      "type": "object"
    },
    "snowflake": {
      "additionalProperties": false,
      "description": "A Snowflake account, reached with ``warehouse`` and, if given, ``role``. ``obo`` signs in\nas the analyst through External OAuth, with a token for ``scope``; ``workload_identity``\nsigns in as TIM's workload identity.",
      "properties": {
        "name": {
          "pattern": "^[a-z0-9-]+$",
          "title": "Name",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "type": {
          "const": "snowflake",
          "title": "Type",
          "type": "string"
        },
        "auth": {
          "enum": [
            "obo",
            "workload_identity"
          ],
          "title": "Auth",
          "type": "string"
        },
        "scope": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Scope"
        },
        "account": {
          "title": "Account",
          "type": "string"
        },
        "warehouse": {
          "title": "Warehouse",
          "type": "string"
        },
        "role": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Role"
        }
      },
      "required": [
        "name",
        "title",
        "type",
        "auth",
        "account",
        "warehouse"
      ],
      "title": "snowflake",
      "type": "object"
    }
  },
  "items": {
    "discriminator": {
      "mapping": {
        "kusto": "#/$defs/kusto",
        "lookup": "#/$defs/lookup",
        "snowflake": "#/$defs/snowflake"
      },
      "propertyName": "type"
    },
    "oneOf": [
      {
        "$ref": "#/$defs/kusto"
      },
      {
        "$ref": "#/$defs/lookup"
      },
      {
        "$ref": "#/$defs/snowflake"
      }
    ]
  },
  "type": "array"
}
