# The example instance under Compose: TIM's deploy/compose.prod.yaml with these on top of the
# operator's own deploy/.env (docs/actions.md#building-and-deploying):
#   docker compose -f deploy/compose.prod.yaml --env-file deploy/.env \
#     --env-file <this file> up -d --no-build

# The derived image: TIM's api image with the provider installed. Name its tag
# <tim version>-<revision>.
TIM_API_IMAGE=registry.example.com/tim-instance
TIM_API_IMAGE_TAG=2.0.0-example.1

# This repo's config/ on the host, mounted read-only at /etc/tim.
TIM_CONFIG_DIR=/srv/tim-instance/config
TIM_ACTIONS_DIR=/etc/tim/actions
TIM_CONNECTIONS_FILE=/etc/tim/connections.yaml
TIM_LABELS_FILE=/etc/tim/labels.yaml
