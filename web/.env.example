# Build-time fallbacks. Values in window.appConfig (public/config.js) take precedence.
# Empty values and unsubstituted "$VAR" placeholders count as missing.
VITE_AUTH_CLIENT_ID=
VITE_AUTH_AUTHORITY=https://login.microsoftonline.com/<tenant-id>
VITE_AUTH_REDIRECT=http://localhost:5173/blank.html
VITE_API_ENDPOINT=
# Optional; empty runs AG Grid as a trial (watermark).
VITE_AGGRID_LICENSE_KEY=
VITE_HELP_WIKI_URI=
VITE_HELP_ISSUE_URI=
# Dev auth: `true` uses a fixed fake account and token (no Entra). Throws in production builds.
VITE_AUTH_STUB=
