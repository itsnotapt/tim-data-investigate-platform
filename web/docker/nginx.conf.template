# Rendered by docker-entrypoint.sh. @BACKEND_URI@ and @NGINX_RESOLVER@ are validated before
# substitution. Do not add other placeholders without extending the entrypoint.

map $http_x_forwarded_proto $tim_forwarded_proto {
    default $http_x_forwarded_proto;
    ""      $scheme;
}

server {
    listen 8080;
    server_name _;
    server_tokens off;

    root /usr/share/nginx/html;
    index index.html;

    # Security headers. Only `expires` (not add_header) is used in locations below, so these
    # are not lost to add_header inheritance rules.
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;

    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 5;
    gzip_min_length 1024;
    gzip_types text/plain text/css text/javascript application/javascript application/json
               application/wasm image/svg+xml font/ttf font/otf;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # Runtime config and the SPA shell must never be cached (config changes per deploy, and
    # index.html references hashed assets).
    location = /config.js {
        expires -1;
        try_files $uri =404;
    }

    location = /index.html {
        expires -1;
    }

    # Vite output is content-hashed.
    location /assets/ {
        expires 1y;
        try_files $uri =404;
    }

    # API proxy. The backend is addressed through a variable so nginx starts even if the
    # backend is not resolvable yet, and so re-resolves it (DNS changes in k8s / compose).
    # proxy_pass has no URI part, so the original request URI is forwarded unchanged and the
    # /api prefix is kept (legacy BUG-10: an ingress rewrite stripped it).
    location /api/ {
        resolver @NGINX_RESOLVER@ valid=10s ipv6=off;
        set $tim_backend "@BACKEND_URI@";
        proxy_pass $tim_backend;

        proxy_http_version 1.1;
        proxy_ssl_server_name on;
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $tim_forwarded_proto;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header Connection "";

        client_max_body_size 25m;
        # Kusto runs can take up to TIM_QUERY_TIMEOUT_SECONDS (default 600).
        proxy_read_timeout 620s;
        proxy_send_timeout 620s;
    }

    # Hash routing: no SPA fallback needed.
    location / {
        try_files $uri $uri/ =404;
    }
}
