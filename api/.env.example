# Copy to .env for local development. Never commit real secrets.
# All variables are read with the TIM_ prefix. List values are comma-separated.

# development | production (default production)
TIM_ENVIRONMENT=development
# CRITICAL | ERROR | WARNING | INFO | DEBUG
TIM_LOG_LEVEL=INFO

# --- Auth (required) ---
TIM_AUTH_TENANT_ID=00000000-0000-0000-0000-000000000000
# API audience is api://<client id>
TIM_AUTH_CLIENT_ID=00000000-0000-0000-0000-000000000000
# Required unless AZURE_FEDERATED_TOKEN_FILE (workload identity) is set; startup fails without one.
# TIM_AUTH_CLIENT_SECRET=
# Optional authority host, override for sovereign clouds
# TIM_AUTH_AUTHORITY_HOST=https://login.microsoftonline.com
# Dev only: disables token validation; every request runs as a fixed dev user.
# Rejected when TIM_ENVIRONMENT=production.
# TIM_AUTH_DISABLED=false

# --- Kusto ---
# OBO scope template; {cluster} is the cluster base URI
# TIM_KUSTO_OBO_SCOPE={cluster}/.default
# Tag cluster (required, https) and database
TIM_TAG_CLUSTER_URI=https://example.westeurope.kusto.windows.net
# TIM_TAG_DATABASE=Research
# Optional ingest URL; derived from the tag cluster URI when unset
# TIM_TAG_INGEST_URL=https://ingest-example.westeurope.kusto.windows.net
# Dev only: use an in-memory fake instead of real ingestion (ignored unless
# TIM_ENVIRONMENT=development; without it, tag writes go to the tag cluster)
# TIM_TAG_INGEST_FAKE=false
# App identity for tag ingest/admin is read by azure-identity (DefaultAzureCredential):
# AZURE_CLIENT_ID=
# AZURE_TENANT_ID=
# AZURE_CLIENT_SECRET=

# --- Cluster allow-list: clusters must be https and match a pattern ---
# Kusto clusters users may query (comma-separated patterns). A pattern is an exact host
# (`help.kusto.windows.net`), `*.domain` (exactly one label before the domain) or `**.domain`
# (one or more labels). Blank = the default `**.kusto.windows.net`. Fabric is opt-in, e.g.
# `**.kusto.windows.net,**.kusto.fabric.microsoft.com`.
# TIM_ALLOWED_KUSTO_HOSTS=**.kusto.windows.net

# --- PostgreSQL (required, ADR-0004) ---
TIM_DATABASE_URL=postgresql+asyncpg://tim:change-me@localhost:5432/tim
# Development only: in-memory store, data lost on restart (rejected in production)
# TIM_DATABASE_URL=memory://

# How often expired query runs are deleted (they are hidden from reads regardless)
# TIM_RUN_RETENTION_SWEEP_SECONDS=300

# --- HTTP ---
# Comma-separated origins, default none
# TIM_CORS_ALLOWED_ORIGINS=http://localhost:5173
# Hard cap on any request body (bytes); larger requests get 413
# TIM_MAX_REQUEST_BYTES=16777216

# --- Query-run limits ---
# TIM_MAX_RESULT_ROWS=100000
# TIM_MAX_RESULT_BYTES=67108864
# TIM_QUERY_TIMEOUT_SECONDS=600
# TIM_RUN_RETENTION_SECONDS=86400
# Runs executing at once per process; further runs wait
# TIM_MAX_CONCURRENT_RUNS=16
