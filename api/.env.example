# Copy to .env for local development. Never commit real secrets.
# All variables are read with the TIM_ prefix. List values are comma-separated.

# development | production (default production)
TIM_ENVIRONMENT=development
# CRITICAL | ERROR | WARNING | INFO | DEBUG
TIM_LOG_LEVEL=INFO

# --- Auth (required) ---
TIM_AUTH_TENANT_ID=00000000-0000-0000-0000-000000000000
# API audience is api://<client id>
TIM_AUTH_CLIENT_ID=00000000-0000-0000-0000-000000000000
# Required when a connection uses obo, unless AZURE_FEDERATED_TOKEN_FILE (workload identity) is
# set; startup then fails without one.
# TIM_AUTH_CLIENT_SECRET=
# Optional authority host, override for sovereign clouds
# TIM_AUTH_AUTHORITY_HOST=https://login.microsoftonline.com
# Dev only: disables token validation; every request runs as the analyst its stub token
# (Bearer dev:<upn>) names, or a fixed dev user without one.
# Rejected when TIM_ENVIRONMENT=production.
# TIM_AUTH_DISABLED=false

# --- Actions (ADR-0017) ---
# One flat directory of action files (*.yaml, *.yml), read at startup. A missing directory
# stops startup.
# TIM_ACTIONS_DIR=
# Dev only: registers the development actions (tim.dev_json, dev_rows). Rejected when
# TIM_ENVIRONMENT=production. With the e2e scenarios as the action files:
# TIM_DEV_ACTIONS=true
# TIM_ACTIONS_DIR=../web/e2e/actions

# --- PostgreSQL (required, ADR-0004) ---
TIM_DATABASE_URL=postgresql+asyncpg://tim:change-me@localhost:5432/tim
# Development only: in-memory store, data lost on restart (rejected in production)
# TIM_DATABASE_URL=memory://

# How often expired runs are deleted (they are hidden from reads regardless)
# TIM_RUN_RETENTION_SWEEP_SECONDS=300

# --- HTTP ---
# Comma-separated origins, default none
# TIM_CORS_ALLOWED_ORIGINS=http://localhost:5173
# Hard cap on any request body (bytes); larger requests get 413
# TIM_MAX_REQUEST_BYTES=67108864

# --- Run limits ---
# Result caps of a run
# TIM_MAX_RESULT_ROWS=1000000
# TIM_MAX_RESULT_BYTES=536870912
# TIM_RUN_TIMEOUT_SECONDS=600
# TIM_RUN_RETENTION_SECONDS=86400
# Runs executing at once per process; further runs wait
# TIM_MAX_CONCURRENT_RUNS=16
# Rows per page of GET /api/runs/{runId}/rows
# TIM_ROWS_PAGE_SIZE=10000
