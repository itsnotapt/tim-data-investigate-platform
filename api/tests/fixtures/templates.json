    "database": "Samples",
    "columnId": "EventId",
    "params": {
      "State": {
        "type": "string",
        "hint": "US state"
      }
    },
    "fields": {
      "State": {
        "type": "single"
      }
    },
    "columns": {},
    "query": "StormEvents\n| where StartTime between (datetime({{starttime}}) .. datetime({{endtime}}))\n| where State == '{{State}}'\n| extend EventId = tostring(EventId)\n| take 100"
