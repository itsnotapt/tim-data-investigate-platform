# Copy to deploy/.env (git-ignored) and fill in. Used by deploy/compose.prod.yaml.
# Names match the dev compose stack; reference: docs/deployment.md. Never commit real values.

# --- Images ---
# Local build names by default (`up --build`). For published images, use a matching pair, e.g. the
# versions a chart release pins in deploy/helm/tim/image-tags.yaml:
#   TIM_API_IMAGE=ghcr.io/itsnotapt/tim-data-investigate-platform/backend
#   TIM_API_IMAGE_TAG=<backend version, e.g. 4.0.0>
#   TIM_WEB_IMAGE=ghcr.io/itsnotapt/tim-data-investigate-platform/frontend
#   TIM_WEB_IMAGE_TAG=<frontend version, e.g. 1.6.0>
TIM_API_IMAGE=tim-api
TIM_API_IMAGE_TAG=local
TIM_WEB_IMAGE=tim-web
TIM_WEB_IMAGE_TAG=local

# --- Published ports / public URL ---
WEB_PORT=8080
# Public URL users open (scheme://host[:port], no trailing slash). REDIRECT_URI must be
# registered as a SPA redirect URI in the Entra app registration.
PUBLIC_URL=https://tim.example.com
# Subnet of the compose network (fixed so the api can trust X-Forwarded-* from web only). Change it
# if it overlaps a host, VPN or Docker Desktop range.
TIM_SUBNET=10.89.0.0/24
# Address(es) uvicorn trusts for X-Forwarded-*; defaults to TIM_SUBNET. Override only with an external proxy.
#FORWARDED_ALLOW_IPS=

# --- PostgreSQL ---
POSTGRES_USER=tim
POSTGRES_PASSWORD=change-me
POSTGRES_DB=tim

# --- Entra ID (required) ---
TIM_AUTH_TENANT_ID=
TIM_AUTH_CLIENT_ID=
# Client secret for OBO (required; the api does not start without an OBO credential).
TIM_AUTH_CLIENT_SECRET=

# --- Kusto (required) ---
TIM_TAG_CLUSTER_URI=https://<cluster>.<region>.kusto.windows.net
TIM_TAG_DATABASE=Research
# Kusto clusters users may query (comma-separated patterns). A pattern is an exact host
# (`help.kusto.windows.net`), `*.domain` (exactly one label before the domain) or `**.domain`
# (one or more labels). Blank = the default `**.kusto.windows.net`. Fabric is opt-in, e.g.
# `**.kusto.windows.net,**.kusto.fabric.microsoft.com`.
TIM_ALLOWED_KUSTO_HOSTS=
# Extra CORS origins (comma separated). Not needed when the SPA is served by web.
TIM_CORS_ALLOWED_ORIGINS=
TIM_LOG_LEVEL=INFO

# --- Web ---
# AG Grid Enterprise licence key -> config.js `agGridLicenseKey` (ADR-0006). Optional: leave
# empty to run AG Grid Enterprise in trial mode (watermark and console notice).
AGGRID_LICENSE=
HELP_WIKI_URI=
HELP_ISSUE_URI=
# JSON array of {name, clusters, databases}; empty = one entry from the tag cluster/database.
DEFAULT_CLUSTERS=
