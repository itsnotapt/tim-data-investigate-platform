# Copy to deploy/.env (git-ignored) and fill in. Used by deploy/compose.prod.yaml.
# Names match the dev compose stack and docs/rewrite/deployment.md. Never commit real values.

# --- Published ports / public URL ---
WEB_PORT=8080
# Public URL users open (scheme://host[:port], no trailing slash). REDIRECT_URI must be
# registered as a SPA redirect URI in the Entra app registration.
PUBLIC_URL=https://tim.example.com
# Address(es) uvicorn trusts for X-Forwarded-*; the compose network subnet is fixed below.
FORWARDED_ALLOW_IPS=172.29.0.0/16

# --- PostgreSQL ---
POSTGRES_USER=tim
POSTGRES_PASSWORD=change-me
POSTGRES_DB=tim

# --- Entra ID (required) ---
TIM_AUTH_TENANT_ID=
TIM_AUTH_CLIENT_ID=
# Client secret for OBO. Leave empty only when using federated/managed identity.
TIM_AUTH_CLIENT_SECRET=

# --- Kusto (required) ---
TIM_TAG_CLUSTER_URI=https://<cluster>.<region>.kusto.windows.net
TIM_TAG_DATABASE=Research
# Extra allowed Kusto hosts (comma separated), beyond *.kusto.windows.net suffixes.
TIM_ALLOWED_KUSTO_HOSTS=
TIM_LOG_LEVEL=INFO

# --- Web (required in production) ---
# AG Grid Enterprise licence key -> config.js `agGridLicenseKey` (Q-027). Container refuses
# to start without it.
AGGRID_LICENSE=
HELP_WIKI_URI=
HELP_ISSUE_URI=
