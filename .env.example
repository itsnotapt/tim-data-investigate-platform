# Copy to .env for `docker compose up` (see docs/rewrite/local-dev.md). .env is git-ignored.
# Every variable has the same default inside compose.yaml, so this file is optional for dev.
# Never put real secrets in .env.example.

# --- PostgreSQL (dev defaults; the api URL is built from these) ---
POSTGRES_USER=tim
POSTGRES_PASSWORD=tim
POSTGRES_DB=tim

# --- Host ports ---
POSTGRES_PORT=5432
API_PORT=8080
WEB_PORT=8081

# --- API ---
# Dev only: skips token validation, every request runs as a fixed dev user. The api refuses
# to start with this set when TIM_ENVIRONMENT=production (compose pins development).
TIM_AUTH_DISABLED=true
TIM_LOG_LEVEL=INFO
# Entra ids, also passed to the web container as AUTH_CLIENT_ID / AUTH_TENANT_ID.
TIM_AUTH_TENANT_ID=00000000-0000-0000-0000-000000000000
TIM_AUTH_CLIENT_ID=00000000-0000-0000-0000-000000000000
# Real auth only (TIM_AUTH_DISABLED=false): the app registration's secret Value, used for OBO.
TIM_AUTH_CLIENT_SECRET=
# Real tag ingest only: identity for DefaultAzureCredential (needs ingestor on the tag database).
# Leave commented out unless used; an empty AZURE_* value breaks credential discovery.
# To reuse the app registration:
# AZURE_TENANT_ID=${TIM_AUTH_TENANT_ID}
# AZURE_CLIENT_ID=${TIM_AUTH_CLIENT_ID}
# AZURE_CLIENT_SECRET=${TIM_AUTH_CLIENT_SECRET}
# Tag cluster (https) and database; also passed to web as TAG_CLUSTER / TAG_DATABASE.
TIM_TAG_CLUSTER_URI=https://example.westeurope.kusto.windows.net
TIM_TAG_DATABASE=Research

# --- Web ---
# Must match the published web port and be registered in Entra once real auth lands.
REDIRECT_URI=http://localhost:8081/blank.html
# Optional in development (TIM_ENVIRONMENT=development); required in production (ADR-0006).
AGGRID_LICENSE=
