# Copy to .env for `docker compose up` (see docs/development.md). .env is git-ignored.
# Every variable has the same default inside compose.yaml, so this file is optional for dev.
# Never put real secrets in .env.example.

# --- PostgreSQL (dev defaults; the api URL is built from these) ---
POSTGRES_USER=tim
POSTGRES_PASSWORD=tim
POSTGRES_DB=tim

# --- Host ports ---
POSTGRES_PORT=5432
API_PORT=8080
WEB_PORT=8081

# --- API ---
# Dev only: skips token validation, each request runs as the analyst its stub token names. The
# api refuses to start with this set when TIM_ENVIRONMENT=production (compose pins development).
# It is also the web container's STUB_SIGN_IN, so it must be exactly true or false.
# With true, the web container shows "Who are you?". With false, it signs in with Entra.
TIM_AUTH_DISABLED=true
TIM_LOG_LEVEL=INFO
# Entra ids, also passed to the web container as AUTH_CLIENT_ID / AUTH_TENANT_ID (used only
# with TIM_AUTH_DISABLED=false).
TIM_AUTH_TENANT_ID=00000000-0000-0000-0000-000000000000
TIM_AUTH_CLIENT_ID=00000000-0000-0000-0000-000000000000
# OBO client secret; needed only with TIM_AUTH_DISABLED=false. Empty counts as unset.
TIM_AUTH_CLIENT_SECRET=

# --- Instance files (deploy/config/README.md) ---
# Host directory mounted read-only at /etc/tim in the api container. Default ./deploy/config.
# For the e2e instance: TIM_CONFIG_DIR=./web/e2e with the three paths below and TIM_DEV_ACTIONS=true.
#TIM_CONFIG_DIR=./deploy/config
# Container paths under /etc/tim; empty means none, e.g. TIM_ACTIONS_DIR=/etc/tim/actions.
TIM_ACTIONS_DIR=
TIM_CONNECTIONS_FILE=
TIM_LABELS_FILE=
# Dev only: the development actions and the dev_kql connection type.
TIM_DEV_ACTIONS=false

# --- Web ---
# With TIM_AUTH_DISABLED=false: must match the published web port and be registered as a
# redirect URI in Entra.
REDIRECT_URI=http://localhost:8081/blank.html
# AG Grid Enterprise licence key (optional; the grid runs in trial mode without it, ADR-0006).
AGGRID_LICENSE=
# Help link targets; empty uses the built-in project wiki and issue tracker.
HELP_WIKI_URI=
HELP_ISSUE_URI=
