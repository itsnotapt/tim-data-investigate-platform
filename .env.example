# Copy to .env for `docker compose up` (see docs/development.md). .env is git-ignored.
# Every variable has the same default inside compose.yaml, so this file is optional for dev.
# Never put real secrets in .env.example.

# --- PostgreSQL (dev defaults; the api URL is built from these) ---
POSTGRES_USER=tim
POSTGRES_PASSWORD=tim
POSTGRES_DB=tim

# --- Host ports ---
POSTGRES_PORT=5432
API_PORT=8080
WEB_PORT=8081

# --- API ---
# Dev only: skips token validation, every request runs as a fixed dev user. The api refuses
# to start with this set when TIM_ENVIRONMENT=production (compose pins development).
TIM_AUTH_DISABLED=true
TIM_LOG_LEVEL=INFO
# Entra ids, also passed to the web container as AUTH_CLIENT_ID / AUTH_TENANT_ID.
TIM_AUTH_TENANT_ID=00000000-0000-0000-0000-000000000000
TIM_AUTH_CLIENT_ID=00000000-0000-0000-0000-000000000000
# Tag cluster (https) and database; also passed to web as TAG_CLUSTER / TAG_DATABASE.
TIM_TAG_CLUSTER_URI=https://example.westeurope.kusto.windows.net
TIM_TAG_DATABASE=Research
# OBO client secret; needed only with TIM_AUTH_DISABLED=false. Empty counts as unset.
TIM_AUTH_CLIENT_SECRET=
# Kusto clusters users may query (comma-separated patterns). A pattern is an exact host
# (`help.kusto.windows.net`), `*.domain` (exactly one label before the domain) or `**.domain`
# (one or more labels). Blank = the default `**.kusto.windows.net`. Fabric is opt-in, e.g.
# `**.kusto.windows.net,**.kusto.fabric.microsoft.com`.
TIM_ALLOWED_KUSTO_HOSTS=

# --- Web ---
# Must match the published web port and be registered as a redirect URI in Entra.
REDIRECT_URI=http://localhost:8081/blank.html
# AG Grid Enterprise licence key (optional; the grid runs in trial mode without it, ADR-0006).
AGGRID_LICENSE=
# Help link targets; empty uses the built-in project wiki and issue tracker.
HELP_WIKI_URI=
HELP_ISSUE_URI=
# JSON array of {"name": "...", "clusters": ["https://..."], "databases": ["..."]}; empty means one
# group built from the tag cluster and database.
DEFAULT_CLUSTERS=
